{
  "entry": ["src/index.ts"],
  "ignorePatterns": ["dist/**", "coverage/**", "node_modules/**", "scripts/**", "src/import-meta-url.js", "src/lib/keep-a-changelog.js"],
  "ignoreDependencies": ["@alexanderfortin/semantic-release-keep-a-changelog"],
  "rules": {
    "unused-exports": "warn",
    "unused-files": "warn",
    "unused-types": "warn",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "warn",
    "unused-enum-members": "off",
    "duplicate-exports": "warn"
  },
  "duplicates": {
    "minLines": 6,
    "minTokens": 50
  }
}
